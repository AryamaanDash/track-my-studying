# Local-only database settings used by the `dev:docker` and
# `db:migrate:docker` scripts. Copy this file to .env.docker.local.
# Authentication settings continue to come from the standard .env files.

DATABASE_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"
PRISMA_DATABASE_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"
POSTGRES_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"
POSTGRES_PRISMA_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"

DIRECT_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"
PRISMA_MIGRATE_DATABASE_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"
POSTGRES_URL_NON_POOLING="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"

PGPOOL_MAX="5"
