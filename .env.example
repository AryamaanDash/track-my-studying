# Auth.js secret used to sign session cookies and JWTs.
AUTH_SECRET="replace-with-a-long-random-string"

# Runtime database connection. Prefer a pooled URL in serverless production.
# If your provider gives you only one URL, use the same value for both.
# For the local PostgreSQL container in compose.yaml, use:
# postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"
PRISMA_DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"

# Optional maximum connections per warm application instance (defaults to 5).
PGPOOL_MAX="5"

# Optional direct/non-pooled URL used by `prisma migrate deploy`.
# Vercel Postgres also exposes POSTGRES_URL_NON_POOLING automatically.
# For local Docker development, use the same localhost URL shown above.
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"
PRISMA_MIGRATE_DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"

# Optional: enable concise server timing logs outside development.
SERVER_PERFORMANCE_LOGS="0"
