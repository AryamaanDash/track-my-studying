# Copy to .env only if it does not already exist. Never commit real secrets.
# Generate a host-only Auth.js secret: openssl rand -base64 32
AUTH_SECRET=""

# Local-only PostgreSQL credentials matching compose.yaml.
# For hosted environments use provider URLs and the required TLS settings.
DATABASE_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"
# Prisma migrations need a direct/non-pooled connection.
DIRECT_URL="postgresql://track_my_studying:local_development_password@localhost:5432/track_my_studying?sslmode=disable"

# Optional maximum connections per warm application instance.
PGPOOL_MAX="5"
# Bound connection establishment and pool-queue waits (milliseconds).
PGPOOL_CONNECTION_TIMEOUT_MS="10000"
# Operation completion, errors, limiter decisions, and pool metrics always log.
# This flag only enables the dashboard's additional timing breakdown.
SERVER_PERFORMANCE_LOGS="0"
# Operations at or above this duration are flagged slow (milliseconds).
SLOW_OPERATION_MS="1000"
# Minimum interval for unchanged pool-state samples; transitions log immediately.
# Samples happen during pool activity; there is no background polling timer.
POOL_LOG_INTERVAL_MS="30000"

# Shared rate limiting. Use the same Redis database, auth secret, and prefix on
# every instance of an environment. These are server-only credentials.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_PREFIX="track-my-studying"
# Vercel automatically uses x-vercel-forwarded-for. For self-hosting, configure
# a header that your trusted ingress OVERWRITES with exactly one client IP.
# Leave empty if there is no trusted ingress; requests share an "unknown" bucket.
RATE_LIMIT_IP_HEADER=""
# Optional local-only opt-out. Honored ONLY when NODE_ENV=development.
# Set to 1 in your local .env if you deliberately want to develop without Redis.
RATE_LIMIT_DISABLED="0"
